# ============================================================
# 理堂 校历配置标准 v1
# 文件：CalendarStandard.config
# 编码：UTF-8
#
# 用途：
#   1. 告诉 App 每个学期的第 1 周从哪天开始；
#   2. 标记理论教学周、考试周、短期学期、寒暑假；
#   3. 给「当前学期 / 当前周 / 假期状态」提供本地兜底。
#
# 说明：
#   - 只做学期和周次，不做节假日覆盖，也不推算调休；
#   - 所有日期加英文引号，格式 "YYYY-MM-DD"；
#   - weeks 写 "开始周-结束周"；
#   - type 只能是：teaching / short_term / exam / vacation。
# ============================================================

schemaVersion: 1
timezone: "Asia/Shanghai"
academicYear: "2026-2027"
updatedAt: "2026-10-24"

# 留空表示按日期自动判断；也可以强制写 "2026-2027-1"
currentTerm: ""

terms:
  - id: "2026-2027-1"
    label: "2026-2027学年第一学期"
    week1Monday: "2026-09-07"
    totalWeeks: 24
    weekTypes:
      - weeks: "1-2"
        type: "short_term"
        label: "短期学期"
      - weeks: "3-18"
        type: "teaching"
        label: "理论教学"
      - weeks: "19-20"
        type: "exam"
        label: "考试周"
      - weeks: "21-24"
        type: "vacation"
        label: "寒假"
    vacation:
      name: "寒假"
      start: "2027-01-25"
      end: "2027-02-21"

  - id: "2026-2027-2"
    label: "2026-2027学年第二学期"
    week1Monday: "2027-02-22"
    totalWeeks: 27
    weekTypes:
      - weeks: "1-16"
        type: "teaching"
        label: "理论教学"
      - weeks: "17-18"
        type: "exam"
        label: "考试周"
      - weeks: "19-20"
        type: "short_term"
        label: "短期学期"
      - weeks: "21-27"
        type: "vacation"
        label: "暑假"
    vacation:
      name: "暑假"
      start: "2027-07-12"
      end: "2027-08-29"

notes: "上海理工大学 2026-2027 学年校历"
